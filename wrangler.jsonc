{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tm",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "tm-db", "database_id": "9951ea1d-ab4d-44a8-8ba5-9e962092cf82", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "jinhyuk--xyz" }],
  "vars": { "MAX_SCRIPT_BYTES": "524288", "TURNSTILE_HOSTNAME": "jinhyuk.xyz" }
}
