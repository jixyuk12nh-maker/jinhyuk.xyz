{
  "name": "tm-lua-host",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tm-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tm-db --remote",
    "owner:create": "node scripts/create-owner.mjs",
    "check": "node --check src/worker.js && node --check public/app.js && node --check scripts/create-owner.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
